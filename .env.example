# =============================================================================
# StockSchool — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# NEVER commit `.env`. Only `.env.example` belongs in git.
#
# The prefix on each key tells you where it is allowed to be used:
#   NEXT_PUBLIC_*  → safe to ship to the browser (never put secrets here)
#   (no prefix)    → SERVER-ONLY. Never reference these from a Client Component.
# =============================================================================

# -----------------------------------------------------------------------------
# Binance Web3 API — SERVER-ONLY SECRETS
# -----------------------------------------------------------------------------
# Get these from the Binance Web3 dev portal: https://web3.binance.com/en/dev-portal
# Registering the hackathon team email raises your rate limits.
#
# These are read ONLY inside src/lib/binance/client.ts, which runs on the server.
# They are never prefixed with NEXT_PUBLIC_ and never reach the browser.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Base host for the Binance Web3 API — the same domain as the developer portal,
# NOT `api.web3.binance.com`, which does not exist. Pointing at it fails as a DNS
# error, which surfaces in the UI as "could not reach the market data service" and
# reads like a credential problem. It is not one.
#
# The signed request path is built as `{BINANCE_WEB3_BASE_PATH}{endpoint}` — the
# `/build` prefix is mandatory and is the single most common cause of
# `40102 Invalid signature`.
BINANCE_WEB3_BASE_URL=https://web3.binance.com
BINANCE_WEB3_BASE_PATH=/build

# Request timeout for upstream calls, in milliseconds.
BINANCE_WEB3_TIMEOUT_MS=8000

# Seconds a successful RWA response is considered fresh. Serves as both the
# HTTP cache TTL and the "is this stale?" threshold in the UI.
BINANCE_WEB3_CACHE_TTL_SECONDS=60

# Default chain for RWA lookups. 56 = BNB Smart Chain, 1 = Ethereum,
# 8453 = Base, CT_501 = Solana. Most tokenized stocks live on BSC.
NEXT_PUBLIC_DEFAULT_CHAIN_ID=56

# -----------------------------------------------------------------------------
# Database — SERVER-ONLY SECRET
# -----------------------------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, Railway, or local Postgres).
# Must include `sslmode=require` for hosted providers.
#
# IMPORTANT: the app is designed to degrade gracefully. If DATABASE_URL is
# absent or unreachable, progress and simulator state fall back to browser
# localStorage and the UI shows a "device only" sync badge. Nothing crashes.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public site URL — used for metadata, Open Graph tags and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "1" to force the On-Chain Lab onto a public RPC instead of the
# Binance Web3 Wallet API. Useful when you have no API key at all.
NEXT_PUBLIC_FORCE_PUBLIC_RPC=0

# -----------------------------------------------------------------------------
# BNB Smart Chain RPC — optional
# -----------------------------------------------------------------------------
# Used by the On-Chain Lab for direct `eth_call` reads (name/symbol/decimals/
# totalSupply). Leave blank to use the public BSC dataseed endpoints, which are
# rate-limited but need no key. A dedicated endpoint (QuickNode, Ankr, dRPC,
# NodeReal) is strongly recommended for demos so reads never 429 mid-presentation.
BSC_RPC_URL=
